      "requiresAgentId": true,
      "artifacts": [
        {
          "path": ".har/artifacts/auth-unit-tests",
          "kind": "directory",
          "description": "Report, result JSON and raw evidence of auth-unit-tests"
        }
      ],
      "tier": "full"
    },
    {
      "id": "auth-e2e",
      "kind": "test",
      "description": "auth-change S3 — live attack probes: JWT forgery, token rotation, authenticated-route sweep, impersonation isolation (line gate, never on verify)",
      "script": "stages/auth-e2e.sh",
      "requiresAgentId": true,
