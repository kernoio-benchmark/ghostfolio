{
  "$comment": "Territory of the auth-change line. factory-line-router (verify --full) requires a green S3 gate for the exact tree whenever a change matches any of these. Globs are relative to the repo root; ** spans directories.",
  "paths": [
    ".har/lines/auth-change/**",
    "apps/api/src/app/endpoints/auth/**",
    "apps/api/src/app/endpoints/auth-devices/**",
    "apps/api/src/app/endpoints/api-keys/**",
    "apps/api/src/app/endpoints/accesses/**",
    "apps/api/src/app/endpoints/oauth/**",
    "apps/api/src/app/endpoints/users/**",
    "apps/api/src/app/app.module.spec.ts",
    "apps/api/src/app/__snapshots__/app.module.spec.ts.snap",
    "apps/api/src/guards/**",
    "apps/api/src/decorators/**",
    "apps/api/src/middlewares/**",
    "apps/api/src/helper/bearer-token.helper*",
    "apps/api/src/helper/mcp-oauth.helper*",
    "apps/api/src/helper/security-headers.helper*",
    "apps/api/src/services/access/**",
    "apps/api/src/services/api-key/**",
    "apps/api/src/services/auth-device/**",
    "apps/api/src/services/impersonation/**",
    "apps/api/src/services/user/**",
    "apps/api/src/main.ts",
    "libs/common/src/lib/permissions.ts",
    "libs/common/src/lib/scopes*.ts",
    "libs/common/src/lib/dtos/*access*.ts",
    "libs/common/src/lib/dtos/auth-device.dto.ts",
    "libs/common/src/lib/types/impersonation-context.type.ts",
    "apps/client/src/app/core/auth.guard.ts",
    "apps/client/src/app/core/auth.interceptor.ts",
    "apps/client/src/app/services/token-storage.service.ts",
    "apps/client/src/app/services/impersonation-storage.service.ts",
    "apps/client/src/app/services/web-authn.service.ts",
    "apps/client/src/app/pages/auth/**",
    "apps/client/src/app/pages/webauthn/**",
    "apps/client/src/app/pages/register/**",
    "apps/client/src/app/components/login-with-access-token-dialog/**"
  ],
  "ignore": ["**/*.scss", "**/*.stories.ts"],
  "prismaModels": ["User", "Access", "ApiKey", "AuthDevice", "Role", "AccessType", "Provider"],
  "specs": [
    "apps/api/src/app/app.module.spec.ts",
    "apps/api/src/app/endpoints/auth/**/*.spec.ts",
    "apps/api/src/app/endpoints/oauth/**/*.spec.ts",
    "apps/api/src/guards/**/*.spec.ts",
    "apps/api/src/decorators/**/*.spec.ts",
    "apps/api/src/middlewares/**/*.spec.ts",
    "apps/api/src/helper/bearer-token.helper.spec.ts",
    "apps/api/src/helper/mcp-oauth.helper.spec.ts",
    "apps/api/src/helper/security-headers.helper.spec.ts",
    "apps/api/src/services/impersonation/**/*.spec.ts",
    "apps/api/src/services/user/**/*.spec.ts",
    "apps/api/src/services/api-key/**/*.spec.ts",
    "libs/common/src/lib/scopes*.spec.ts",
    "libs/common/src/lib/permissions*.spec.ts"
  ]
}
