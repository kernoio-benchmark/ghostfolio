# Agent environment — generated by `har env launch` from .har/env.template
# DO NOT EDIT — regenerated on every launch
AGENT_ID=${AGENT_ID}

# Ports (allocated at launch — may differ from BASE + AGENT_ID × STEP when busy)
# PORT/HOST are read by the NestJS API (apps/api/src/main.ts).
PORT=${API_PORT}
HOST=0.0.0.0
FE_PORT=${FE_PORT}
API_PORT=${API_PORT}
DEBUG_PORT=${DEBUG_PORT}

# PostgreSQL — shared container, per-slot database agent_<id> (cloned from template)
PGHOST=localhost
PGPORT=${DB_PORT}
PGDATABASE=agent_${AGENT_ID}
PGUSER=postgres
PGPASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:${DB_PORT}/agent_${AGENT_ID}?connect_timeout=300

# Redis — shared container, per-slot logical database number = AGENT_ID so Bull
# queues and the cache never mix between slots. Host port = the fixed `redis`
# lane in harness.env (HARNESS_INFRA_PORT_LANES); the runtime does not scan it.
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=password
REDIS_DB=${AGENT_ID}

# Application secrets — fixed, non-secret dev values so the documented demo
# security token (see .har/README.md) hashes the same way in every slot.
ACCESS_TOKEN_SALT=har-agent-access-token-salt
JWT_SECRET_KEY=har-agent-jwt-secret-key-${AGENT_ID}
ROOT_URL=http://localhost:${FE_PORT}

# Agent-friendly runtime: no background market-data cron (avoids Yahoo/CoinGecko
# traffic from every slot); trigger data gathering from the Admin Control panel.
ENABLE_FEATURE_CRON=false

# Nx: no cloud, no daemon (one daemon per worktree is wasted RAM), legacy targets
NX_NO_CLOUD=true
NX_DAEMON=false
NX_ADD_PLUGINS=false

NODE_ENV=development

# Toolchain paths — appended by the packaged launch provisioning step
# NODE_BIN=  NPM_BIN=  HARNESS_PKG_EXEC=  PATH=
