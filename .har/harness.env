# Shared harness configuration — Ghostfolio (Nx monorepo: NestJS API + Angular client)
# Generated when the harness is scaffolded, maintained with har env maintain
#
# This file is pure KEY=value config (plus comments) and is schema-validated
# on read. Runtime helpers (har_infra_enabled, har_pg, port resolution) live
# in the HAR package — never define functions or use $-interpolation here.

export HARNESS_PROJECT_NAME=ghostfolio
export HARNESS_USE_WORKTREE=true

# Primary application — the ONE app agents modify and run per-slot.
# Ghostfolio is a single product made of two processes that always change
# together: apps/api (NestJS, `nx run api:serve`) and apps/client (Angular,
# `nx run client:serve`). Both run per slot (see ecosystem.agent.template.cjs).
# PostgreSQL and Redis are external dependencies, shared by all slots.
export HARNESS_PRIMARY_APP=ghostfolio

# Template DB: created EMPTY by setup-infra (the main checkout has no
# node_modules, and running Prisma there would read the developer's own .env).
# Each slot clones it to agent_<id>, then HARNESS_DB_MIGRATE_CMD applies all
# Prisma migrations inside the slot worktree.
export HARNESS_TEMPLATE_DB=template_ghostfolio

# ── Per-slot app ports (PM2 / primary app) ────────────────────────────────────
# Defaults: BASE + (AGENT_ID × HARNESS_PORT_STEP). Launch scans the slot lane
# when busy and writes resolved FE_PORT / API_PORT / DEBUG_PORT to .env.agent.<id>.
# Bases follow the upstream dev ports (Angular 4200, NestJS 3333) so slot N sits
# next to them without colliding: slot 1 → client 4210, API 3340.
export HARNESS_FE_BASE_PORT=4200
export HARNESS_API_BASE_PORT=3330
export HARNESS_PORT_STEP=10
# NestJS health endpoint (global prefix /api + URI versioning v1). Returns 200
# only when both PostgreSQL and Redis are reachable.
export HARNESS_HEALTH_CHECK_PATH=/api/v1/health

# ── Shared infra host ports (one per machine) ─────────────────────────────────
# One lane per infra service: <lane>=<default>:<scan_start>-<scan_end>.
# db is scanned by setup-infra and persisted in .har/state/infra.env.
# redis is not one of the runtime's built-in scanned lanes: its host port is
# fixed at the lane default (docker-compose.agent.yml + env.template must agree).
export HARNESS_INFRA_PORT_LANES="db=15450:15450-15499 redis=16379:16379-16379"

# Agent slot limits — canonical source: .har/stages.json (agentSlots).
# Each slot runs an Angular dev server + a NestJS webpack watcher (~3-4 GB RAM),
# so keep this low. har env maintain --finalize syncs these from stages.json.
export HARNESS_AGENT_SLOT_MIN=1
export HARNESS_AGENT_SLOT_MAX=3

# Toolchain provisioning — launch writes resolved paths into .env.agent.<id>
export HARNESS_ECOSYSTEM="node"
export HARNESS_NODE_PACKAGE_MANAGER="npm"
# Same as CI (npm ci). postinstall runs `prisma generate`.
export HARNESS_INSTALL_CMD="npm ci --no-audit --no-fund"

# Shared infrastructure — docker compose services from docker-compose.agent.yml.
# Started ONCE by setup-infra and shared by all agent slots.
# Per-slot isolation: Postgres DB agent_<id>; Redis logical DB number <id>.
export HARNESS_INFRA_SERVICES="db redis"

# Database setup commands. Both run from the work dir with the slot env sourced.
# MIGRATE: guarded so it only runs when DATABASE_URL is set, i.e. inside a slot
# (the template DB step has no DATABASE_URL and no node_modules → skipped).
export HARNESS_DB_MIGRATE_CMD="printenv DATABASE_URL >/dev/null || exit 0; npm run database:migrate"
# SEED: left empty on purpose. With db in HARNESS_INFRA_SERVICES the runtime
# only seeds the template DB, which is empty. Seeding (prisma/seed.mts tags)
# plus the demo admin user happen per slot in .har/hooks/post-launch.sh.
export HARNESS_DB_SEED_CMD=""

# The post-launch hook bootstraps the demo user agents log in with; if it
# fails the slot is not agent-usable, so fail the launch instead of warning.
export HARNESS_HOOK_POST_FAILURE=fail
